# Токен бота від @BotFather. Нікому не показуйте
BOT_TOKEN=

# Канал для постів: @username або числовий ID (-100...). Бот має бути адміністратором
# каналу з правом "Публікація повідомлень"
CHANNEL_ID=

# Твій Telegram ID (дізнатися в @userinfobot). Лише тобі бот відповідає і пише про помилки.
# Хоча б раз натисни /start у бота, інакше Telegram не дасть йому тобі написати
ADMIN_ID=

# Посилання на канал у кінці посту. Порожньо: @username каналу (якщо канал публічний).
# Для приватного каналу встав посилання-запрошення https://t.me/+...
CHANNEL_LINK=

# Необов'язково, але бажано: токен GitHub без жодних прав (fine-grained token, доступ
# "Public repositories (read-only)"), github.com/settings/personal-access-tokens.
# Без нього GitHub дає 60 запитів на годину на IP, з ним 5000
GITHUB_TOKEN=

# Ключ Lapathonia (той самий постачальник, що в AI-Bot-v2): з ним опис кожного
# репозиторію пише LLM українською. Порожньо: оригінальний опис з GitHub англійською
LAPATHONIA_API_KEY=
LAPATHONIA_BASE_URL=https://api.lapathoniia.top/v1
# Модель для описів
LLM_MODEL=MamayLM-Gemma-3-27B-IT-v2.0

# Розклад: часовий пояс, час публікації, день тижневого топу (monday ... sunday)
# і число місяця для місячного (1-28)
TIMEZONE=Europe/Warsaw
POST_TIME=06:00
WEEKLY_DAY=sunday
MONTHLY_DAY=1

# Якщо сервер був вимкнений у час публікації, пропущений пост вийде після запуску,
# але лише якщо минуло не більше стількох годин. Пізніше пост за той день пропускається
CATCH_UP_HOURS=12

# Скільки репозиторіїв у топі (1-25)
TOP_SIZE=10

# Звідки Telegram бере картинки-шапки day.png, week.png, month.png (прев'ю над постом).
# Типово з цього репозиторію на GitHub, тож він має бути публічним
IMAGES_URL=https://raw.githubusercontent.com/dmytrokurochkin/GitHub-Parser/main/assets
